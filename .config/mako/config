# layout here, colors from pywal (~/.config/wal/templates/colors-mako -> ~/.cache/wal/colors-mako)
anchor=top-right
margin=10
width=320
height=100
padding=10,14
border-size=1
border-radius=0
default-timeout=3000
font=JetBrainsMono Nerd Font 10
format=<b>%s</b>\n%b

include=~/.cache/wal/colors-mako

[urgency=critical]
default-timeout=5000

[app-name="Firefox"]
invisible=1
