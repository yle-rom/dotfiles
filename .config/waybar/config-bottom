{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "bottom",
  "height": 35,
  "margin": "0",
  "modules-left": [
    "custom/prev",
    "custom/play",
    "custom/next",
    "custom/track"
  ],
  "modules-center": [
    "custom/magi-gpu",
    "custom/magi-cpu",
    "custom/magi-ram"
  ],
  "modules-right": [
    "custom/cava"
  ],
  "custom/prev": {
    "exec": "~/.config/waybar/scripts/media.py ctl prev",
    "return-type": "json",
    "on-click": "playerctl previous",
    "tooltip": false
  },
  "custom/play": {
    "exec": "~/.config/waybar/scripts/media.py ctl play",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "tooltip": false
  },
  "custom/next": {
    "exec": "~/.config/waybar/scripts/media.py ctl next",
    "return-type": "json",
    "on-click": "playerctl next",
    "tooltip": false
  },
  "custom/track": {
    "exec": "~/.config/waybar/scripts/media.py track",
    "return-type": "json",
    "escape": false,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": false
  },
  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava.py",
    "return-type": "json",
    "tooltip": false
  },
  "custom/magi-gpu": {
    "exec": "~/.config/waybar/scripts/magi.py gpu",
    "return-type": "json",
    "tooltip": false
  },
  "custom/magi-cpu": {
    "exec": "~/.config/waybar/scripts/magi.py cpu",
    "return-type": "json",
    "tooltip": false
  },
  "custom/magi-ram": {
    "exec": "~/.config/waybar/scripts/magi.py ram",
    "return-type": "json",
    "tooltip": false
  }
}
