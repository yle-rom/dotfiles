{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "right",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "width": 35,
  "spacing": 0,
  "modules-left": [
    "custom/power",
    "custom/net"
  ],
  "modules-right": [
    "custom/ws5",
    "custom/ws6",
    "custom/ws7",
    "custom/ws8"
  ],
  "custom/power": {
    "format": "󰥓",
    "on-click": "~/.local/bin/powermenu",
    "tooltip": false
  },
  "custom/net": {
    "exec": "~/.config/waybar/scripts/sysmon.py net 77",
    "return-type": "json",
    "escape": false,
    "justify": "center"
  },
  "custom/ws5": {
    "exec": "~/.config/waybar/scripts/workspaces.py 5",
    "return-type": "json",
    "escape": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
  },
  "custom/ws6": {
    "exec": "~/.config/waybar/scripts/workspaces.py 6",
    "return-type": "json",
    "escape": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'"
  },
  "custom/ws7": {
    "exec": "~/.config/waybar/scripts/workspaces.py 7",
    "return-type": "json",
    "escape": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'"
  },
  "custom/ws8": {
    "exec": "~/.config/waybar/scripts/workspaces.py 8",
    "return-type": "json",
    "escape": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'"
  }
}
