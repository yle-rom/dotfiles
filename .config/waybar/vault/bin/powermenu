#!/bin/bash
# ─────────────────────────────────────────
#  MAGI POWER CONTROL — Rofi Powermenu
#  NERV Central Dogma
# ─────────────────────────────────────────

# Load wal colors
if [[ -f ~/.cache/wal/colors.sh ]]; then
    source ~/.cache/wal/colors.sh
    accent=$color3
    fg=$foreground
    bg=$background
else
    accent="#f3701e"
    fg="#e8d8c9"
    bg="#000000"
fi

# Options
shutdown="⏻  SHUTDOWN"
reboot="↺  REBOOT"
#lock="  LOCK"
cancel="✕  CANCEL"

# Rofi menu
chosen=$(printf '%s\n' "$shutdown" "$reboot" "$cancel" | rofi \
  -dmenu \
  -p "MAGI POWER CONTROL" \
  -theme-str "
    window {
      width: 320px;
      border: 2px solid;
      border-color: ${accent};
      border-radius: 0px;
      padding: 0px;
      background-color: ${bg};
    }
    mainbox { padding: 0px; spacing: 0px; background-color: ${bg}; }
    inputbar {
      background-color: ${accent};
      text-color: ${fg};
      padding: 12px 16px;
      spacing: 0px;
      children: [prompt];
    }
    prompt {
      background-color: ${accent};
      text-color: ${fg};
      font: \"JetBrainsMono Nerd Font Bold 9\";
      letter-spacing: 3px;
    }
    listview { padding: 8px; spacing: 2px; lines: 3; fixed-height: true; background-color: ${bg}; }
    element { padding: 10px 16px; border-radius: 0px; spacing: 8px; background-color: ${fg}; text-color: ${bg}; }
    element selected { background-color: ${bg}; text-color: ${fg}; }
    element-text { background-color: inherit; text-color: inherit; font: \"JetBrainsMono Nerd Font 11\"; vertical-align: 0.5; }
  ")

# Execute chosen option
case "$chosen" in
  "$shutdown")  systemctl poweroff ;;
  "$reboot")    systemctl reboot ;;
  #"$lock")
  #  if command -v hyprlock &>/dev/null; then hyprlock
  #  elif command -v swaylock &>/dev/null; then swaylock
  #  else loginctl lock-session; fi ;;
  "$cancel"|"") exit 0 ;;
esac
