{
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "height": 10,
    "spacing": 0,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "battery",
        "network",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": {
            "*": 4
        }
    },
    "clock": {
        "format": "{:%e %b %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "⚠",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "alacritty -e nmtui",
        "tooltip-format": "{essid}{ifname} ({signalStrength}%)"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "   {icon} {capacity}%",
        "format-charging": "󱊣{icon} {capacity}%",
        "format-icons": [
            "[░░░░░░░░░░]",
            "[█░░░░░░░░░]",
            "[██░░░░░░░░]",
            "[███░░░░░░░]",
            "[████░░░░░░]",
            "[█████░░░░░]",
            "[██████░░░░]",
            "[███████░░░]",
            "[████████░░]",
            "[█████████░]",
            "[██████████]"
        ],
        "on-click": "~/.local/bin/powerprofile-menu"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 [░░░░░░░░░░] 0%",
        "format-icons": {
            "default": [
                "󰖁 [░░░░░░░░░░]",
                "󰖁 [█░░░░░░░░░]",
                "󰖀 [██░░░░░░░░]",
                "󰖀 [███░░░░░░░]",
                "󰖀 [████░░░░░░]",
                "󰕾 [█████░░░░░]",
                "󰕾 [██████░░░░]",
                "󰕾 [███████░░░]",
                "󰕾 [████████░░]",
                "󰕾 [█████████░]",
                "󰕾 [██████████]"
            ]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },
    "backlight": {
        "format": "󰖨 {icon} {percent}%",
        "format-icons": [
            "[░░░░░░░░░░]",
            "[█░░░░░░░░░]",
            "[██░░░░░░░░]",
            "[███░░░░░░░]",
            "[████░░░░░░]",
            "[█████░░░░░]",
            "[██████░░░░]",
            "[███████░░░]",
            "[████████░░]",
            "[█████████░]",
            "[██████████]"
        ]
    },
    "custom/power": {
        "format": " ⏻",
        "on-click": "~/.local/bin/powermenu",
        "tooltip": false
    }
}
